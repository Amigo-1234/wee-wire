# Copy to .env for local overrides. Never commit real secrets.

# Canonical origin used for canonical URLs and the sitemap.
SITE_URL=https://weewire.com

# Search indexing. Leave unset (or "false") for the prototype and previews.
# Set to "true" ONLY for an approved production launch.
PUBLIC_SITE_INDEXING=false

# Shows "pending confirmation" markers and owner-content placeholders.
# Set to "false" once all business details have been confirmed.
PUBLIC_SHOW_REVIEW_MARKERS=true

# Endpoint for the request-service form (e.g. a form provider URL that accepts
# POSTed form data and returns JSON). When unset, the form validates input but
# does not send anything, and says so.
PUBLIC_FORM_ENDPOINT=
