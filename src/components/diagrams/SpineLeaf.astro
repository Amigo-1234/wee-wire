---
/** Illustrative spine-and-leaf topology, for dark sections. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const titleId = `topo-title-${Math.random().toString(36).slice(2, 8)}`;

const spines = [210, 430];
const leaves = [80, 240, 400, 560];
const spineY = 70;
const leafY = 200;
const serverY = 280;
---

<svg class:list={['topo', className]} viewBox="0 0 640 360" role="img" aria-labelledby={titleId} xmlns="http://www.w3.org/2000/svg">
  <title id={titleId}>Illustration: a spine-and-leaf network topology with two spine switches, four leaf switches and server racks</title>

  <g class="topo__links">
    {spines.map((sx) => leaves.map((lx) => <line x1={sx} y1={spineY + 18} x2={lx} y2={leafY - 18} />))}
  </g>
  <g class="topo__flow">
    {
      spines.map((sx, si) =>
        leaves.map((lx, li) => (
          <line x1={sx} y1={spineY + 18} x2={lx} y2={leafY - 18} pathLength="100" style={`--d:${(si * 4 + li) * -0.45}s`} />
        )),
      )
    }
  </g>

  {
    spines.map((x, i) => (
      <g class="topo__node topo__node--spine">
        <rect x={x - 62} y={spineY - 18} width="124" height="36" />
        <text x={x} y={spineY + 4} text-anchor="middle">{`SPINE ${String(i + 1).padStart(2, '0')}`}</text>
      </g>
    ))
  }

  {
    leaves.map((x, i) => (
      <g class="topo__node">
        <rect x={x - 54} y={leafY - 18} width="108" height="36" />
        <text x={x} y={leafY + 4} text-anchor="middle">{`LEAF ${String(i + 1).padStart(2, '0')}`}</text>
        <line class="topo__drop" x1={x} y1={leafY + 18} x2={x} y2={serverY - 6} />
        {[0, 1, 2].map((r) => (
          <rect class="topo__server" x={x - 34} y={serverY + r * 16} width="68" height="11" />
        ))}
      </g>
    ))
  }

  <text class="topo__caption" x="0" y="20">FABRIC / SPINE-AND-LEAF</text>
</svg>

<style>
  .topo {
    width: 100%;
    height: auto;
  }

  .topo text {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    fill: var(--night-text);
  }

  .topo .topo__caption {
    fill: var(--night-muted);
    font-size: 10px;
  }

  .topo__links line {
    stroke: var(--night-rule);
    stroke-width: 1.25;
  }

  .topo__flow line {
    stroke: var(--copper-on-night);
    stroke-width: 1.5;
    stroke-dasharray: 6 94;
    opacity: 0;
  }

  .topo__node rect {
    fill: var(--night-raised);
    stroke: #5b6773;
    stroke-width: 1;
  }

  .topo__node--spine rect {
    stroke: var(--copper-on-night);
  }

  .topo__drop {
    stroke: #5b6773;
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }

  .topo .topo__server {
    fill: none;
    stroke: #5b6773;
  }

  @media (prefers-reduced-motion: no-preference) {
    .topo__flow line {
      opacity: 1;
      animation: topo-flow 3.6s linear infinite;
      animation-delay: var(--d);
    }
  }

  @keyframes topo-flow {
    from {
      stroke-dashoffset: 100;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
