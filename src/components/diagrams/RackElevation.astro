---
/**
 * Illustrative rack elevation (not a depiction of a real installation).
 */
interface Props {
  class?: string;
  /** Needed only if this diagram appears more than once on a page. */
  idSuffix?: string;
}
const { class: className } = Astro.props;
const titleId = Astro.props.idSuffix ? `rack-title-${Astro.props.idSuffix}` : 'rack-title';

const U = 36; // height of one rack unit in the drawing
const top = 56;
const left = 92;
const width = 300;
const units = 12;

type Item = { u: number; size: number; kind: 'patch' | 'manager' | 'switch' | 'blank' | 'server' | 'firewall'; label?: string };
const items: Item[] = [
  { u: 12, size: 1, kind: 'patch', label: 'Patch panel' },
  { u: 11, size: 1, kind: 'manager' },
  { u: 10, size: 1, kind: 'switch', label: 'Access switch' },
  { u: 9, size: 1, kind: 'patch' },
  { u: 8, size: 1, kind: 'manager' },
  { u: 7, size: 1, kind: 'switch' },
  { u: 6, size: 1, kind: 'blank' },
  { u: 5, size: 2, kind: 'server', label: 'Server' },
  { u: 3, size: 2, kind: 'server' },
  { u: 1, size: 1, kind: 'firewall', label: 'Firewall' },
];

const yFor = (u: number, size: number) => top + (units - (u + size - 1)) * U;
const ports = Array.from({ length: 12 }, (_, i) => i);
const unitLabels = Array.from({ length: units }, (_, i) => units - i);
// Deterministic LED pattern
const ledOn = (row: number, i: number) => (i * 7 + row * 3) % 5 !== 0;
---

<svg class:list={['rack', className]} viewBox="0 0 520 540" role="img" aria-labelledby={titleId} xmlns="http://www.w3.org/2000/svg">
  <title id={titleId}>Illustration: a network rack elevation with patch panels, switches, servers and a firewall</title>

  <!-- unit numbers -->
  <g class="rack__units">
    {unitLabels.map((n, i) => <text x={left - 18} y={top + i * U + U / 2 + 4} text-anchor="end">{String(n).padStart(2, '0')}</text>)}
  </g>

  <!-- frame -->
  <rect class="rack__frame" x={left - 10} y={top - 10} width={width + 20} height={units * U + 20} />
  <line class="rack__rail" x1={left} y1={top - 10} x2={left} y2={top + units * U + 10} />
  <line class="rack__rail" x1={left + width} y1={top - 10} x2={left + width} y2={top + units * U + 10} />

  {
    items.map((item) => {
      const y = yFor(item.u, item.size);
      const h = item.size * U - 4;
      return (
        <g class={`rack__item rack__item--${item.kind}`}>
          <rect class="rack__face" x={left + 4} y={y + 2} width={width - 8} height={h} />
          {item.kind === 'patch' &&
            ports.map((i) => <rect class="rack__port" x={left + 24 + i * 21} y={y + 11} width="13" height="11" />)}
          {item.kind === 'switch' &&
            ports.map((i) => (
              <g>
                <rect class="rack__port" x={left + 24 + i * 21} y={y + 14} width="13" height="11" />
                {ledOn(item.u, i) && (
                  <circle class={`rack__led ${i % 4 === 1 ? 'rack__led--amber' : ''}`} cx={left + 30.5 + i * 21} cy={y + 8} r="2" style={`--d:${(i * 0.37 + item.u * 0.21) % 2.4}s`} />
                )}
              </g>
            ))}
          {item.kind === 'manager' && ports.map((i) => <path class="rack__loop" d={`M ${left + 22 + i * 21} ${y + 26} v -12 a 6 6 0 0 1 12 0 v 12`} />)}
          {item.kind === 'server' && (
            <g>
              {Array.from({ length: 8 }, (_, i) => (
                <rect class="rack__bay" x={left + 20 + i * 26} y={y + 10} width="20" height={h - 18} />
              ))}
              <circle class="rack__led" cx={left + width - 30} cy={y + 18} r="2.5" style={`--d:${item.u * 0.4}s`} />
              <rect class="rack__vent" x={left + width - 64} y={y + 30} width="44" height="24" />
            </g>
          )}
          {item.kind === 'firewall' && (
            <g>
              {[0, 1, 2, 3].map((i) => <rect class="rack__port" x={left + 24 + i * 21} y={y + 12} width="13" height="11" />)}
              <circle class="rack__led" cx={left + 130} cy={y + 17} r="2.5" style="--d:1.3s" />
              <line class="rack__detail" x1={left + 150} y1={y + 17} x2={left + width - 24} y2={y + 17} />
            </g>
          )}
          {item.kind === 'blank' && <line class="rack__detail" x1={left + 20} y1={y + U / 2} x2={left + width - 20} y2={y + U / 2} />}
          {item.label && (
            <g class="rack__callout">
              <line x1={left + width + 10} y1={y + h / 2 + 2} x2={left + width + 34} y2={y + h / 2 + 2} />
              <text x={left + width + 40} y={y + h / 2 + 6}>{item.label.toUpperCase()}</text>
            </g>
          )}
        </g>
      );
    })
  }

  <!-- patch cords between top patch panel and switch -->
  <g class="rack__cords" fill="none">
    {[0, 2, 3, 5, 6, 8, 10, 11].map((i, n) => {
      // Cords drop straight through the cable manager to the port below.
      const x = left + 30.5 + i * 21;
      const y1 = yFor(12, 1) + 22;
      const y2 = yFor(10, 1) + 14;
      const bow = n % 2 ? 5 : -5;
      return <path pathLength="1" d={`M ${x} ${y1} C ${x + bow} ${y1 + 16}, ${x + bow} ${y2 - 16}, ${x} ${y2}`} style={`--i:${n}`} />;
    })}
  </g>

  <!-- dimension -->
  <g class="rack__dim">
    <line x1={left - 54} y1={top} x2={left - 54} y2={top + units * U} />
    <line x1={left - 60} y1={top} x2={left - 48} y2={top} />
    <line x1={left - 60} y1={top + units * U} x2={left - 48} y2={top + units * U} />
    <text x={left - 62} y={top + (units * U) / 2} transform={`rotate(-90 ${left - 62} ${top + (units * U) / 2})`} text-anchor="middle">12U ELEVATION</text>
  </g>
</svg>

<style>
  .rack {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .rack text {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    fill: var(--ink-muted);
  }

  .rack__frame {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .rack__rail {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 2 6;
  }

  .rack__face {
    fill: var(--paper-raised);
    stroke: var(--ink);
    stroke-width: 1;
  }

  .rack__item--switch .rack__face,
  .rack__item--firewall .rack__face {
    fill: #e7e3db;
  }

  .rack__item--blank .rack__face {
    fill: var(--paper-sunk);
  }

  .rack__port {
    fill: var(--ink);
  }

  .rack__bay,
  .rack__vent {
    fill: none;
    stroke: var(--ink);
    stroke-width: 0.75;
  }

  .rack__vent {
    stroke-dasharray: 1 2;
  }

  .rack__loop,
  .rack__detail {
    fill: none;
    stroke: var(--ink-muted);
    stroke-width: 1;
  }

  .rack__led {
    fill: var(--signal);
  }

  .rack__led--amber {
    fill: #e2a93b;
  }

  .rack__callout line,
  .rack__dim line {
    stroke: var(--ink-muted);
    stroke-width: 0.75;
  }

  .rack__cords path {
    stroke: #f07a2e;
    stroke-width: 1.75;
    stroke-linecap: round;
  }

  @media (prefers-reduced-motion: no-preference) {
    .rack__led {
      animation: led-blink 2.4s steps(1, end) infinite;
      animation-delay: var(--d, 0s);
    }

    .rack__cords path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: cord-draw 900ms var(--ease-out) forwards;
      animation-delay: calc(400ms + var(--i) * 90ms);
    }
  }

  @keyframes led-blink {
    0%,
    70% {
      opacity: 1;
    }
    72%,
    78% {
      opacity: 0.25;
    }
    80%,
    100% {
      opacity: 1;
    }
  }

  @keyframes cord-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
