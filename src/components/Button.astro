---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'quiet';

type Props = {
  href?: string;
  variant?: Variant;
  arrow?: boolean;
  class?: string;
} & Omit<HTMLAttributes<'button'>, 'class'>;

const { href, variant = 'primary', arrow = false, class: className, ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, className];
---

{
  href ? (
    <a href={href} class:list={classes}>
      <slot />
      {arrow && <span class="btn__arrow" aria-hidden="true">→</span>}
    </a>
  ) : (
    <button class:list={classes} {...rest}>
      <slot />
      {arrow && <span class="btn__arrow" aria-hidden="true">→</span>}
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    min-height: 3rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.2;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  .btn--primary {
    background: var(--action-bg);
    color: var(--action-text);
    box-shadow: inset 0 -2px 0 rgba(12, 15, 18, 0.18);
  }

  .btn--primary:hover {
    background: var(--action-bg-hover);
  }

  .btn--secondary {
    border-color: currentColor;
    color: inherit;
    background: transparent;
  }

  .btn--secondary:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  :global(.on-night) .btn--secondary:hover {
    background: var(--night-text);
    border-color: var(--night-text);
    color: var(--night);
  }

  .btn--quiet {
    padding-inline: 0;
    min-height: auto;
    color: inherit;
    background: none;
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 0.3em;
  }

  .btn--quiet:hover {
    text-decoration-color: var(--accent);
  }

  :global(.on-night) .btn--quiet:hover {
    text-decoration-color: var(--accent-on-night);
  }

  .btn__arrow {
    transition: transform 200ms var(--ease-out);
  }

  .btn:hover .btn__arrow {
    transform: translateX(3px);
  }
</style>
