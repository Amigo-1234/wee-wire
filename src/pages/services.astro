---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Button from '@/components/Button.astro';
import ReviewTag from '@/components/ReviewTag.astro';
import CtaBand from '@/components/CtaBand.astro';
import Diagram from '@/components/diagrams/Diagram.astro';
import { requestServiceHref } from '@/config/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const core = await Promise.all(
  services.filter((s) => s.data.tier === 'core').map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
const additional = await Promise.all(
  services.filter((s) => s.data.tier === 'additional').map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<BaseLayout
  title="Services"
  description="Structured network cabling, fiber optic troubleshooting, data center deployment, service calls and smart-hands support, plus Starlink installation, TV mounting and commercial VoIP and internet solutions."
>
  <PageHero
    eyebrow="Services"
    title="Cabling, fiber, data center and on-site support."
    lede="The work behind a reliable network: the cable in the walls, the fiber between buildings, the equipment in the rack and a technician on site when it matters."
  >
    <Fragment slot="aside">
      <nav class="svc-index" aria-label="Services on this page">
        <p class="label">On this page</p>
        <ol role="list">
          {
            services.map((s, i) => (
              <li>
                <a href={`#${s.id}`}>
                  <span class="svc-index__num">{String(i + 1).padStart(2, '0')}</span>
                  {s.data.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </Fragment>
  </PageHero>

  {
    core.map(({ entry, Content }, i) => {
      const dark = entry.data.diagram === 'topology';
      return (
        <section id={entry.id} class:list={['svc', 'section', { 'on-night': dark, 'svc--alt': !dark && i % 2 === 1 }]} aria-labelledby={`${entry.id}-title`}>
          <div class="container svc__grid">
            <header class="svc__head" data-reveal>
              <p class="label svc__num">{`${String(i + 1).padStart(2, '0')} / ${String(services.length).padStart(2, '0')}`}</p>
              <h2 id={`${entry.id}-title`}>{entry.data.title}</h2>
              <ReviewTag status={entry.data.status} source={entry.data.source} text="Service pending confirmation" />
            </header>

            <div class="svc__body" data-reveal style="--reveal-delay:80ms">
              <div class="prose svc__prose">
                <Content />
              </div>
              {entry.data.scope.length > 0 && (
                <div class="svc__scope">
                  <h3 class="label">Typical scope</h3>
                  <ul role="list">
                    {entry.data.scope.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                  <ReviewTag status="unverified" text="Draft copy" />
                </div>
              )}
              <div class="svc__actions">
                <Button href={requestServiceHref} variant={dark ? 'secondary' : 'primary'} arrow>
                  Request this service
                </Button>
                {entry.id === 'structured-cabling' || entry.id === 'service-calls-smart-hands' ? (
                  <Button href="/pricing" variant="quiet">
                    See pricing
                  </Button>
                ) : null}
              </div>
            </div>

            {entry.data.diagram && (
              <figure class="svc__figure" data-reveal style="--reveal-delay:160ms">
                <Diagram name={entry.data.diagram} />
              </figure>
            )}
          </div>
        </section>
      );
    })
  }

  <section class="section additional" aria-labelledby="additional-title">
    <div class="container additional__grid">
      <div data-reveal>
        <p class="label">Additional services</p>
        <h2 id="additional-title" class="additional__title">Also available.</h2>
        <p class="additional__note">Scope and pricing for these services are confirmed when the work is quoted.</p>
      </div>
      <dl class="additional__list" data-reveal style="--reveal-delay:80ms">
        {
          additional.map(({ entry, Content }) => (
            <div id={entry.id} class="additional__item">
              <dt>
                {entry.data.title}
                {entry.data.qualifier && <span class="additional__qualifier">{entry.data.qualifier}</span>}
                <ReviewTag status={entry.data.status} source={entry.data.source} />
              </dt>
              <dd>
                <Content />
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CtaBand title="Not sure which service fits?" text="Describe the problem or the project. We will work out the scope with you." />
</BaseLayout>

<style>
  .svc-index ol {
    list-style: none;
    padding: 0;
    margin-top: var(--space-s);
    border-top: 1px solid var(--ink);
    font-size: var(--step--1);
  }

  .svc-index li {
    border-bottom: 1px solid var(--rule);
  }

  .svc-index a {
    display: flex;
    gap: var(--space-s);
    padding-block: 0.55rem;
    text-decoration: none;
  }

  .svc-index a:hover {
    color: var(--accent);
  }

  .svc-index__num {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-muted);
    padding-top: 0.2em;
  }

  .svc {
    border-bottom: 1px solid var(--rule);
  }

  .svc--alt {
    background: var(--paper-raised);
  }

  .svc.on-night {
    border-bottom-color: var(--night-rule);
  }

  .svc__grid {
    display: grid;
    gap: var(--space-l) var(--space-2xl);
  }

  .svc__num {
    margin-bottom: var(--space-s);
  }

  .svc__head h2 {
    font-size: var(--step-4);
    margin-bottom: var(--space-s);
  }

  .on-night .svc__prose {
    color: var(--night-muted);
  }

  .svc__scope {
    margin-top: var(--space-l);
  }

  .svc__scope ul {
    margin-block: var(--space-s);
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .on-night .svc__scope ul,
  .on-night .svc__scope li {
    border-color: var(--night-rule);
  }

  .svc__scope li {
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--rule);
  }

  .svc__scope li::before {
    content: '+';
    display: inline-block;
    width: 1.5rem;
    font-family: var(--font-mono);
    color: var(--accent);
  }

  .on-night .svc__scope li::before {
    color: var(--accent-on-night);
  }

  .svc__scope :global(.review-tag) {
    margin-left: 0;
  }

  .svc__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m) var(--space-l);
    margin-top: var(--space-l);
  }

  .svc__figure {
    max-width: 36rem;
  }

  @media (min-width: 60rem) {
    .svc__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      grid-template-areas:
        'head body'
        'figure body';
      align-items: start;
    }

    .svc__head {
      grid-area: head;
      position: sticky;
      top: calc(var(--header-height) + var(--space-l));
    }

    .svc__body {
      grid-area: body;
    }

    .svc__figure {
      grid-area: figure;
    }
  }

  .additional {
    background: var(--paper-sunk);
  }

  .additional__grid {
    display: grid;
    gap: var(--space-xl);
  }

  .additional__title {
    margin-top: var(--space-s);
    font-size: var(--step-4);
  }

  .additional__note {
    margin-top: var(--space-m);
    color: var(--ink-soft);
    max-width: 26em;
  }

  .additional__list {
    border-top: 1px solid var(--ink);
  }

  .additional__item {
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--rule-strong);
    scroll-margin-top: calc(var(--header-height) + var(--space-l));
  }

  .additional__item dt {
    font-size: var(--step-2);
    font-weight: 620;
    font-stretch: 88%;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .additional__qualifier {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .additional__item dd {
    margin-top: var(--space-2xs);
    color: var(--ink-soft);
  }

  @media (min-width: 60rem) {
    .additional__grid {
      grid-template-columns: 1fr 1.4fr;
    }
  }
</style>
